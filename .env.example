# --- Supabase (the whole DB lives here — no Prisma, no DATABASE_URL) ---
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# --- Only needed locally to seed catalogue + logins (never commit, never ship to client) ---
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
# TEMP_STAFF_PASSWORD="JadePink123!"
# STORE_ID="store-bandra"

# --- Direct Postgres connection: only for npm run db:migrate / db:schema ---
# Dashboard > Project Settings > Database > Connection string.
# Use the SESSION mode URI (port 5432) for DIRECT_URL — the transaction pooler
# (port 6543) breaks DDL sessions. db:migrate prefers DIRECT_URL, falls back to
# DATABASE_URL. Both are inert at app runtime (no Prisma, no ORM).
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres"
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# --- OTP: Supabase-routed (Supabase Auth owns codes; this app delivers SMS) ---
# Free Fast2SMS key (₹50 test credit, Quick-SMS route needs no DLT)
FAST2SMS_API_KEY=""
# Secret from Dashboard > Authentication > Hooks > Send SMS hook (v1,whsec_...)
SEND_SMS_HOOK_SECRET=""
# SMS body; {otp} is replaced with the Supabase-generated code
# OTP_SMS_TEMPLATE="Your JadePink OTP is {otp}. Valid for 5 minutes."
